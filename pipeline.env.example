# Copy to .env (or pass with --env-file) and fill in.

# Where the SQLite state, reference snapshots, logs and outputs are kept
VARIANTSCAPE_WORK_DIR=pipeline_data

# OpenAlex: contact e-mail for the polite pool; API key optional
OPENALEX_EMAIL=
OPENALEX_API_KEY=

# LLM (OpenAI-compatible endpoint; defaults to Llama-3.3-70B on DeepInfra)
LLM_API_KEY=
# LLM_BASE_URL=https://api.deepinfra.com/v1/openai
# LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
# LLM_TEMPERATURE=            # empty = provider default, as in the evaluated notebooks
# LLM_MAX_WORKERS=8
# LLM_VERIFY_MODEL=           # optional separate model for the association verification step
# LLM_VERIFY_TEMPERATURE=0    # verification step; default 0 (deterministic labels); empty = provider default

# Full runs fetch works published from this date; incremental runs continue from the
# previous run's end date minus the overlap (already-fetched papers are skipped)
# VARIANTSCAPE_FULL_START_DATE=2014-01-01
# VARIANTSCAPE_OVERLAP_DAYS=30
# VARIANTSCAPE_SEARCH_TERM=("cancer" OR "carcinoma" OR "tumor")

# Gene set that makes a paper relevant: oncology (OncoKB + CIViC, default), civic,
# or a panel file (relative paths are relative to the Variantscape folder).
# civic and panels also restrict the graph's variants to their genes.
# VARIANTSCAPE_GENE_SET=oncology

# Gene detection method: biobert (as in 03.1) or string (fast exact symbol match, as in 03.0)
# VARIANTSCAPE_GENE_FILTER=biobert
# VARIANTSCAPE_DEVICE=-1      # -1 = CPU, 0 = first GPU

# Match extracted cancer terms against CIViC/MONDO synonyms as well as names
# VARIANTSCAPE_USE_CANCER_SYNONYMS=true

# EvidenceDb checkout used by --deploy
# VARIANTSCAPE_EVIDENCEDB_DIR=../evidence-database
